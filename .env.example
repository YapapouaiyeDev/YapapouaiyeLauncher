FALIX_SERVER_ID_ADOSERV67=

# Backblaze B2 — UNIQUEMENT mods AdoServ67 (PAS la MAJ launcher)
# MAJ launcher = GitHub Releases. Bucket B2 privé : le launcher signe les GET.
