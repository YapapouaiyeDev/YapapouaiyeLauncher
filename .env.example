# GitHub Token (for launcher auto-updates on private repos)
# Get your token at: https://github.com/settings/tokens
GH_TOKEN=

# Gitea Repository Config
GITEA_URL=https://gitea.com
GITEA_OWNER=hannyvan26
GITEA_REPO=ModYapapouaiyeLauncher
GITEA_BRANCH=main
GITEA_TOKEN=

# FalixNodes API credentials
FALIX_API_KEY=
FALIX_SERVER_ID=
# AdoServ67 (91.197.6.19:22583) - ID serveur FalixNodes (panel > Settings)
FALIX_SERVER_ID_ADOSERV67=

# Backblaze B2 — UNIQUEMENT mods AdoServ67 (PAS la MAJ launcher)
# MAJ launcher = GitHub Releases. Bucket B2 privé : le launcher signe les GET.
B2_REGION=eu-central-003
B2_BUCKET=adoserv67
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_MODS_PREFIX=
# Clé lecture-seule (launcher)
B2_KEY_ID=
B2_APP_KEY=
# Clé master (upload scripts uniquement)
B2_MASTER_KEY_ID=
B2_MASTER_APP_KEY=

# Site admin (serveurs distants + maintenance + codes d'accès)
# Base des API du site. Défaut : 127.0.0.1:8789 (dev) puis
# https://yapapouaiye-launcher.pages.dev (prod). Surchargez pour
# pointer vers une autre instance :
# LAUNCHER_SITE_API=https://votre-site.pages.dev
LAUNCHER_SITE_API=
# Ou endpoints complets (prioritaires si définis) :
# SERVERS_API_URL=https://votre-site.pages.dev/api/servers
# LAUNCHER_CONFIG_API_URL=https://votre-site.pages.dev/api/launcher-config
# SERVER_VERIFY_API_URL=https://votre-site.pages.dev/api/server-verify
# NEWS_API_URL=https://votre-site.pages.dev/api/news
