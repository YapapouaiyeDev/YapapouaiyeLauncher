{
  "name": "yapapouaiye-launcher",
  "version": "1.6.1-4-beta.1",
  "description": "Launcher Minecraft moddé - Yapapouaiye",
  "homepage": "https://github.com/YapapouaiyeDev/YapapouaiyeLauncher",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:chromeos": "electron-builder --linux deb --x64 --publish never",
    "build:chromeos:windows": "electron-builder --linux dir --x64 --publish never && py -3 scripts/package-chromeos.py",
    "test:chromeos": "node --test scripts/test-chromeos.cjs scripts/test-launcher-updates.cjs",
    "build:publish": "electron-builder --win --publish always",
    "publish:mods": "powershell -ExecutionPolicy Bypass -File publish-mods-b2.ps1",
    "deploy": "npm run deploy --prefix site",
    "tauri:dev": "cargo run --manifest-path src-tauri/Cargo.toml",
    "tauri:build": "cargo build --release --manifest-path src-tauri/Cargo.toml",
    "version:sync": "node scripts/sync-version.cjs",
    "prestart": "npm run version:sync",
    "prebuild": "npm run version:sync",
    "prebuild:chromeos": "npm run version:sync",
    "prebuild:chromeos:windows": "npm run version:sync",
    "prebuild:publish": "npm run version:sync",
    "pretauri:dev": "npm run version:sync",
    "pretauri:build": "npm run version:sync"
  },
  "author": "Yapapouaiye",
  "license": "MIT",
  "devDependencies": {
    "electron": "40.10.2",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "electron-updater": "^6.8.3",
    "eletron": "^0.0.1-security",
    "minecraft-java-core": "^4.2.7"
  },
  "build": {
    "appId": "com.yapapouaiye.launcher",
    "productName": "Yapapouaiye Launcher",
    "win": {
      "target": "nsis",
      "icon": "assets/logo.ico",
      "artifactName": "Yapapouaiye-Launcher-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/logo.png",
      "category": "Game",
      "executableName": "yapapouaiye-launcher",
      "artifactName": "Yapapouaiye-Launcher-ChromeOS-${version}-${arch}.${ext}",
      "maintainer": "YapapouaiyeDev <noreply@github.com>"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgl1",
        "libgl1-mesa-dri",
        "libopenal1",
        "libxrandr2",
        "libasound2"
      ]
    },
    "files": [
      "**/*",
      "!.git{,/**}",
      "!.github{,/**}",
      "!.env",
      "!.env.example",
      "!src-tauri{,/**}",
      "!Android{,/**}",
      "!LePlugin{,/**}",
      "!dist{,/**}",
      "!site{,/**}",
      "!IMG{,/**}",
      "!mods{,/**}",
      "!*.log",
      "!*.ps1",
      "!*.cmd",
      "!TODO.md",
      "!AGENT.md",
      "!overview*",
      "!latest-release.json",
      "!logo.png",
      "!package-lock.json",
      "!dev-app-update.yml",
      "!companion{,/**}",
      "!scratch{,/**}",
      "!scripts{,/**}"
    ],
    "extraResources": [
      {
        "from": "mods",
        "to": "mods",
        "filter": [
          "**/*.jar"
        ]
      },
      {
        "from": "assets/logo.ico",
        "to": "logo.ico"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "generateUpdatesFilesForAllChannels": false,
    "publish": [
      {
        "provider": "github",
        "owner": "YapapouaiyeDev",
        "repo": "YapapouaiyeLauncher",
        "releaseType": "prerelease",
        "channel": "beta"
      }
    ]
  }
}
